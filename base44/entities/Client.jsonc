{
  "name": "Client",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "first_name": {
      "type": "string",
      "description": "First name only"
    },
    "invite_code": {
      "type": "string",
      "description": "6 chars, uppercase, unique"
    },
    "language": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ],
      "default": "es"
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "complete",
        "delivered",
        "wiped"
      ],
      "default": "invited"
    },
    "linked_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "name_on_documents": {
      "type": "string",
      "description": "Full name exactly as it appears on her documents, entered by the provider; used only for the name-match check"
    },
    "documents_visible_to_client": {
      "type": "boolean",
      "default": false,
      "description": "Whether the client can see her own document list (off by default)"
    }
  },
  "required": [
    "first_name",
    "invite_code"
  ],
  "rls": {
    "read": true,
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
